# --- Продакшен (скопируйте в .env на сервере и подставьте свои секреты) ---
APP_NAME=K16
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://k16.arguss.lv

# Для Латвии / русского интерфейса раскомментируйте при необходимости:
# APP_TIMEZONE=Europe/Riga
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP: порт 465 — scheme smtps (не используйте MAIL_ENCRYPTION в Laravel 11+)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.arguss.lv
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI-зрение для чтения счётчиков (основной путь). Модель по фото сразу отдаёт показание.
# Ключ бесплатно: https://aistudio.google.com/apikey → вставьте в GEMINI_API_KEY.
AI_VISION_ENABLED=false
AI_VISION_PROVIDER=gemini
AI_VISION_TIMEOUT=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# Google Cloud Vision (fallback, опционально). Используется, если AI-зрение выключено
# или вернуло ошибку. В GCP: APIs & Services → Library → Cloud Vision API → Enable;
# IAM → Service accounts → ключ JSON. Файл положите в storage/app/private/ (не в public).
# В .env — абсолютный путь, например:
#   Linux: /home2/user/k16.arguss.lv/storage/app/private/your-key.json
#   Windows: C:\laragon\www\water\storage\app\private\your-key.json
GOOGLE_VISION_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VISION_TRANSPORT=rest

# Тест ввода показаний / OCR вне календарного окна: true — жилец всегда видит форму за текущий месяц,
# можно снова сохранять и грузить фото. На боевом сайте — только false.
WATER_SUBMISSION_WINDOW_BYPASS=false

# Если после WATER_SUBMISSION_WINDOW_BYPASS=true всё равно «нет прав» (кэш конфига и т.д.) — временно true:
# Gate полностью пропускает проверку дат для жильца своей квартиры. Потом false и config:clear.
WATER_METER_READING_GATE_BYPASS=false
